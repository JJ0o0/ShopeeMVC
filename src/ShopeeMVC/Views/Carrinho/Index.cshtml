@model List<CarrinhoItem>
@{ ViewData["Title"] = "Meu carrinho"; var total = Model.Sum(x => x.Subtotal); }
<div class="heading"><div><p class="eyebrow">SUA SELEÇÃO</p><h1>Meu carrinho</h1><p>@Model.Sum(x => x.Quantidade) unidade(s)</p></div><a class="btn secondary" asp-controller="Produto" asp-action="Index">Continuar comprando</a></div>
@if (!Model.Any()) { <section class="empty"><span class="empty-icon" aria-hidden="true">🛒</span><h2>Seu carrinho está vazio</h2><p>Adicione seus produtos favoritos para começar.</p><a class="btn" asp-controller="Produto" asp-action="Index">Explorar produtos</a></section> }
else { <div class="cart-grid"><section class="panel table-wrap"><table><caption class="sr-only">Produtos do carrinho</caption><thead><tr><th scope="col">Produto</th><th scope="col">Preço</th><th scope="col">Quantidade</th><th scope="col">Subtotal</th><th scope="col">Ações</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><strong>@item.Nome</strong></td><td>@item.Preco.ToString("C")</td><td><form class="quantity" asp-action="Atualizar" asp-route-id="@item.ProdutoId" method="post"><label class="sr-only" for="q-@item.ProdutoId">Quantidade de @item.Nome</label><input id="q-@item.ProdutoId" name="quantidade" type="number" min="1" value="@item.Quantidade" required /><button class="btn small secondary">Atualizar</button></form></td><td><strong>@item.Subtotal.ToString("C")</strong></td><td><form asp-action="Remover" asp-route-id="@item.ProdutoId" method="post"><button class="text-button danger-text">Remover</button></form></td></tr> }</tbody></table></section><aside class="panel summary"><h2>Resumo do carrinho</h2><div class="total"><span>Total</span><strong>@total.ToString("C")</strong></div><p class="muted">Subtotal = preço × quantidade.<br />Total = soma dos subtotais.</p><a class="btn full" asp-controller="Produto" asp-action="Index">Adicionar mais produtos</a><form asp-action="Limpar" method="post"><button class="btn secondary full">Esvaziar carrinho</button></form><small>O carrinho não reserva estoque. Sua sessão expira após 30 minutos de inatividade.</small></aside></div> }
