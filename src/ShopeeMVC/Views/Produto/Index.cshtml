@model IReadOnlyList<Produto>
@{ ViewData["Title"] = "Produtos"; }
<section class="hero"><div><p class="eyebrow">SUA LOJA DE TECNOLOGIA</p><h1>Seu próximo upgrade<br />começa aqui.</h1><p>Explore os produtos e monte seu carrinho.</p></div><span class="hero-icon" aria-hidden="true">🛍️</span></section>
<div class="heading"><div><h2>Produtos disponíveis</h2><p>@Model.Count produto(s) no catálogo</p></div><a class="btn secondary" asp-action="Create">+ Novo produto</a></div>
@if (Model.Count == 0) { <div class="empty"><h2>O catálogo está vazio</h2><p>Cadastre o primeiro produto para começar.</p><a class="btn" asp-action="Create">Cadastrar produto</a></div> }
else { <div class="products">@foreach (var item in Model) { <article class="card"><div class="product-art" aria-hidden="true">@(item.Nome.Contains("Mouse", StringComparison.OrdinalIgnoreCase) ? "🖱️" : item.Nome.Contains("Teclado", StringComparison.OrdinalIgnoreCase) ? "⌨️" : item.Nome.Contains("Headset", StringComparison.OrdinalIgnoreCase) ? "🎧" : "📦")</div><div class="card-body"><span class="stock">@(item.Estoque > 0 ? $"{item.Estoque} em estoque" : "Esgotado")</span><h3>@item.Nome</h3><p class="price">@item.Preco.ToString("C")</p><form asp-controller="Carrinho" asp-action="Adicionar" asp-route-id="@item.Codigo" method="post"><button class="btn full" disabled="@(item.Estoque == 0)">Adicionar ao carrinho</button></form><div class="card-actions"><a asp-action="Details" asp-route-id="@item.Codigo">Detalhes</a><a asp-action="Edit" asp-route-id="@item.Codigo">Editar</a><a class="danger-text" asp-action="Delete" asp-route-id="@item.Codigo">Excluir</a></div></div></article> }</div> }
