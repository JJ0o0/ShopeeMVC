@model ProdutoForm
<div asp-validation-summary="All" class="validation" role="alert"></div>
<input type="hidden" asp-for="Codigo" />
<div class="field"><label asp-for="Nome"></label><input asp-for="Nome" maxlength="100" required /><span asp-validation-for="Nome" class="validation"></span></div>
<div class="form-grid"><div class="field"><label asp-for="Preco"></label><input asp-for="Preco" type="text" inputmode="decimal" placeholder="80,00" required /><small>Use vírgula para os centavos. Exemplo: 80,00.</small><span asp-validation-for="Preco" class="validation"></span></div><div class="field"><label asp-for="Estoque"></label><input asp-for="Estoque" type="number" min="0" max="1000000" required /><span asp-validation-for="Estoque" class="validation"></span></div></div>
<div class="actions"><button class="btn" type="submit">Salvar produto</button><a class="btn secondary" asp-action="Index">Cancelar</a></div>
