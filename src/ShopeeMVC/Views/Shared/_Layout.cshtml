@inject ShopeeMVC.Services.CarrinhoService Carrinho
@{ var quantidade = Carrinho.ObterCarrinho(Context.Session).Sum(x => x.Quantidade); }
<!DOCTYPE html>
<html lang="pt-BR">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] · ShopeeMVC</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body>
<header><nav class="container" aria-label="Navegação principal"><a class="brand" asp-controller="Produto" asp-action="Index"><span class="bag">S</span> Shopee<span>MVC</span></a><div class="nav-links"><a asp-controller="Produto" asp-action="Index">Produtos</a><a asp-controller="Produto" asp-action="Create">Cadastrar</a><a class="cart-link" asp-controller="Carrinho" asp-action="Index">Carrinho <span class="badge">@quantidade</span></a></div></nav></header>
<main class="container">
@foreach (var chave in new[] { "Sucesso", "Aviso" }) { if (TempData[chave] is string texto) { <div class="notice @(chave == "Aviso" ? "warning" : "")" role="status">@texto</div> } }
@RenderBody()
</main>
<footer class="container">Prática de desenvolvimento web · ASP.NET Core MVC / SQL Server<br /><small>Carrinho temporário por sessão. Não realiza pagamentos.</small></footer>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
